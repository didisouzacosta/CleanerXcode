//
//  Secrets.example.xcconfig
//  CleanerXcode
//
//  Copy this file to Secrets.xcconfig (same folder, git-ignored) and fill in the values.
//  Config.xcconfig includes it when present; without it the app builds with analytics
//  and crash reporting disabled.
//
//  In xcconfig files "//" starts a comment, so write URLs with "/$()/" instead of "//",
//  for example: SENTRY_DSN = https:/$()/<key>@o<org>.ingest.sentry.io/<project>
//

HIMETRICA_API_KEY =
SENTRY_DSN =
